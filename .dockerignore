# Build context for the API image (backend/Dockerfile, context = repo root).
# It only COPYs backend/* and scripts/agg_core.py + scripts/import_spec.py —
# everything else just bloats the context, so exclude it.
.git
.github
node_modules
frontend
.editorconfig
.gitignore
.impeccable
.env
*.md
docker-compose.yml
.dockerignore
**/__pycache__
# never ship source exports or pipeline backups
**/*.xlsx
**/*.xls
