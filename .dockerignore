# keep the image small and clean: only index.html + css/ + js/ + data/ are COPYed,
# but this also guards COPY data/ from pulling in backups, and speeds up the build context.
.git
.github
node_modules
server.js
package.json
package-lock.json
.editorconfig
.gitignore
.impeccable
.env
*.md
docker-compose.yml
.dockerignore
**/__pycache__
# note: nginx.conf and scripts/agg_core.py are NOT ignored — the Dockerfiles COPY them
# (the web image only COPYs index.html/css/js/data, so scripts/ won't bloat it)
# never ship source exports or pipeline backups
**/*.xlsx
**/*.xls
data/data.backup-*.json
