# Copy to .env and fill in (Portainer: paste these as stack environment variables).
# The API reads the SAME table you query in pgAdmin (it must mirror the MATELINE export).

PG_HOST=host.docker.internal      # DB host. host.docker.internal = a Postgres on the Docker host
PG_PORT=5432
PG_DB=your_database
PG_USER=your_user
PG_PASSWORD=your_password
PG_TABLE=MATELINE_TICKET_CLOSED   # if the table was created with quotes/caps, use "MATELINE_TICKET_CLOSED"

# How to derive each row's YYYY-MM bucket. Columns are snake_case -> use the 'closed' date.
# If 'closed' is stored as text (e.g. 2026-05-01...), use:  left(closed,7)
MONTH_SQL=to_char(closed, 'YYYY-MM')

# Column names default to snake_case (work_order_id, source_ticket_id, closed, ...).
# Only set this if a column name differs from the defaults. JSON of {MATELINE name: db column}:
# COLMAP_JSON={"Team":"team","Source Ticket ID":"source_ticket_id","WO Creator":"wo_creator","Complete Solution":"complete_solution","Work Type":"work_type","Root Cause":"root_cause","SLA":"sla","Site ID":"site_id","Province":"province","Region":"region","Skill":"skill","Status":"status","Severity":"severity"}

CACHE_TTL=600                      # seconds to cache the computed result (live-ish, avoids re-querying 800k rows per request)
